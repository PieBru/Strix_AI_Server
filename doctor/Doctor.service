# Doctor — 24/7 system + inference doctor (:8667), independent of llama-server;
# auto-improving per repo Principles #3
# Sibling of sysmon.py in this directory (which it will eventually retire). Single-file
# stdlib server + htmx: system cards (GPU/RAM/disk), inference cards
# (resident arm, live tg + draft acc charts), error banner (health/service/
# journal/dmesg minus known-benign patterns), tail-f activity log with copy,
# operator links (/res/ini, morning report, sweep results, harvest stats).
# Read-only: no ini writes, no arm swaps, no privileged calls.
# LAN-exposed, no auth (operator decision, same trust boundary as :8080).
# ~25 MB RSS flat, sub-1% one core (2s poll).
#
# Install (runs straight from the checkout — no copy into $HOME):
#   1. edit ExecStart below to your checkout path; set DOCTOR_UNITS to the
#      router units to watch (default: the reference box's; this repo's:
#      llama-hip, llama-vulkan) — no edits to Doctor.py needed
#   2. install -Dm644 doctor/Doctor.service ~/.config/systemd/user/Doctor.service
#   3. systemctl --user daemon-reload && systemctl --user enable --now Doctor

[Unit]
Description=Doctor — 24/7 system + inference doctor (:8667), independent of llama-server; auto-improving per repo Principles #3

[Service]
Type=simple
# OOM policy (doctor 260924 F1-A1): neutral score + MemoryHigh cap so the
# monitor is capped, not volunteered, in an OOM round.
OOMScoreAdjust=0
MemoryHigh=256M
# Reference box checkout — edit to yours.
ExecStart=%h/Piero/Work/Strix_AI_Server/doctor/Doctor.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
