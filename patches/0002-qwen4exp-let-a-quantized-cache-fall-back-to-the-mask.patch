From bc6999c5e2e3564dbb17042c69cfef315b2bc657 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 23 Sep 2026 08:36:05 +0200
Subject: [PATCH 2/2] qwen4exp: let a quantized cache fall back to the masked
 QSA path
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The HIP qsa fast path asserted 256-dim heads on F16 K/V, so enabling
--cache-type-k/v (the KV-quant headroom route to 256k context) aborted
the process at graph build. The requirement now lives in the
direct_indices predicate: F16 caches keep the fast path untouched,
quantized caches take the masked dense path — the same construction
upstream ships and this fork already uses for decode ubatches and
non-HIP backends. Compiles clean (build-qv); GPU validation pending.
---
 src/models/qwen4exp.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index b9361e18..b162a538 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -1317,9 +1317,14 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
         ggml_tensor * top_k = ggml_view_4d(ctx0, indices_all, indices_all->ne[0], n_query, 1, n_stream,
                 indices_all->nb[1], indices_all->nb[2], indices_all->nb[3], first*indices_all->nb[1]);
 
+        // 260923 [KV-QUANT]: the HIP qsa fast path requires 256-dim heads on an
+        // F16 cache; a quantized cache (the 256k-headroom route) takes the masked
+        // dense path below — the same design upstream ships — instead of aborting.
         const bool direct_indices =
             n_stream == 1 && cparams.flash_attn && cparams.offload_kqv &&
-            hparams.f_max_alibi_bias == 0.0f && !hparams.attn_soft_cap;
+            hparams.f_max_alibi_bias == 0.0f && !hparams.attn_soft_cap &&
+            q_cur->ne[0] == 256 &&
+            mctx_cur->type_k() == GGML_TYPE_F16 && mctx_cur->type_v() == GGML_TYPE_F16;
         ggml_tensor * kq_mask_top_k = kq_mask;
         if (!direct_indices) {
         // prepare new kq mask - starts filled with -INFINITY
@@ -1362,7 +1367,7 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
         const int64_t n_kv_max = top_k->ne[0];
         ggml_tensor * cur;
         if (direct_indices) {
-            GGML_ASSERT(q->ne[0] == 256 && k->type == GGML_TYPE_F16 && v->type == GGML_TYPE_F16);
+            // contract moved into direct_indices (260923): quantized caches fall back to the masked path
             const bool v_trans = v->nb[1] > v->nb[2];
             ggml_tensor * q_view = ggml_permute(ctx0, q, 0, 2, 1, 3);
             ggml_tensor * k_view = ggml_permute(ctx0, k, 0, 2, 1, 3);
-- 
