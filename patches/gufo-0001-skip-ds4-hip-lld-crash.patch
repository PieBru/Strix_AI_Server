+// stub.cpp — GUFO_SKIP_DS4=1 build: the nightly lld 24 crashes linking the ds4
+// device kernels (LTO CallGraph pass), so this file provides fatal stubs for the
+// symbols the CLI references. Any attempt to actually serve a ds4 model fails
+// loudly instead of silently. Remove when the toolchain is fixed upstream.
+#include "src/models/deepseek_v4_flash/engine.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <utility>
+
+namespace gufo::models::deepseek_v4_flash {
+namespace {
+[[noreturn]] void Fail(const char* what) {
+  std::fprintf(stderr, "gufo: %s unavailable (built with GUFO_SKIP_DS4=1)\n", what);
+  std::abort();
+}
+}  // namespace
+
+bool ValidateGgufTemplate(const core::GgufReader& reader, std::string* error_msg) {
+  (void)reader;
+  if (error_msg) *error_msg = "deepseek_v4_flash disabled in this build";
+  return false;
+}
+
+Model::~Model() = default;
+Session::~Session() = default;
+
+std::shared_ptr<Model> Model::Load(const std::string&, const ModelOptions&,
+                                   std::string* error_msg) {
+  if (error_msg) *error_msg = "deepseek_v4_flash disabled in this build";
+  return nullptr;
+}
+
+std::unique_ptr<Session> Model::CreateSession(core::SessionMode, std::uint32_t,
+                                              std::string* error_msg) {
+  if (error_msg) *error_msg = "deepseek_v4_flash disabled in this build";
+  return nullptr;
+}
+
