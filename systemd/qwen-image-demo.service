# qwen-image-demo — official Qwen-Image-2.1 gradio demo app (qwen-space/, :7860).
# GPU work lives in gufo-serve (:8081). Conflicts: llm arms + the test app
# (same port). On-demand — not boot-enabled.
[Unit]
Description=Qwen-Image-2.1 official demo app on 0.0.0.0:7860 (gufo backend)
After=network.target gufo-serve.service
Conflicts=llama-llm.service gufo-llm.service qwen-image-test.service

[Service]
WorkingDirectory=/home/piero/Piero/Work/QImage21
# --offline: the 260927 fix, missed here because this unit was not running that day. Off-
# internet it re-resolved against pypi (3 retries ~47s) and died status=2/INVALIDARGUMENT into
# start-limit-hit, so the Doctor's "demo :7860" button started a crash loop. Found by the
# 261001 offline cold-start drill; the live unit carries the same line as a drop-in.
ExecStart=/usr/bin/uv run --offline --with gradio --with numpy --with requests --with pillow python qwen-space/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
